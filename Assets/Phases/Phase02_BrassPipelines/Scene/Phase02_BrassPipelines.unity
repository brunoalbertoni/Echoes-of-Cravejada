  m_Script: {fileID: 11500000, guid: f7a44ff4d0402c04598a74914119237f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::EchoesOfCravejada.Npc
  displayName: "p\xE1gina do livro de turnos"
  lines:
  - "LIVRO DE TURNOS DA CALDEIRA \u2014 turno da manh\xE3."
  - "A \xE1gua t\xE1 com gosto de metal podre. Troquei o cano e n\xE3o adiantou:
    o problema vem de baixo, do fundo da rocha."
  - Quem pega turno perto das caldeiras sai tossindo verde.
  purifiedLines: []
  prompt: ler
  facesPlayer: 0
  document: {fileID: 21300000, guid: 95ad0c4470490ad4e8c23cb152ebd6bf, type: 3}
  purifiedDocument: {fileID: 0}
