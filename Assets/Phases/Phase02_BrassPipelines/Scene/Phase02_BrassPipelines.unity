  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f7a44ff4d0402c04598a74914119237f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::EchoesOfCravejada.Npc
  displayName: "o di\xE1rio do chefe de manuten\xE7\xE3o"
  lines:
  - Um caderno de capa de couro, deixado no alto da torre, virado pra sala das caldeiras.
  - "\"Se as caldeiras pararem, o vapor para. Sem vapor, o pessoal aqui de baixo
    congela antes mesmo de o \xD3xido chegar.\""
  - "\"Vou ficar com elas e manter a press\xE3o. Tranquem a porta por fora e n\xE3o
    abram, escutem o que escutarem.\""
  - "Embaixo da marca de uma m\xE3o, queimada no papel: \"Esse \xE9 o meu sacrif\xEDcio.
    \u2014 O chefe de manuten\xE7\xE3o.\""
  purifiedLines: []
  prompt: ler
  facesPlayer: 0
  document: {fileID: 21300000, guid: 278bbe887ed9596499dd7b54cdd12d2a, type: 3}
  purifiedDocument: {fileID: 0}
