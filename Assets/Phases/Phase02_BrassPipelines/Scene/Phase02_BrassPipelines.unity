  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::EchoesOfCravejada.Npc
  displayName: "a ficha do dep\xF3sito"
  lines:
  - "Uma ficha de invent\xE1rio, pregada na porta do dep\xF3sito."
  - "\"ORDEM DA COROA: recolher todas as m\xE1scaras de solda e envi\xE1-las ao alto
    de Cravejada, a Cidade de Prata. Prioridade: Nobres.\""
  - "Logo abaixo, \xE0 m\xE3o: \"Recolhidas: nenhuma. N\xE3o h\xE1 m\xE1scaras neste
    dep\xF3sito. \u2014 O chefe de manuten\xE7\xE3o.\""
  - "Nas prateleiras atr\xE1s da ficha, s\xF3 restam as marcas de caixas retiradas
    \xE0s pressas."
  purifiedLines: []
  prompt: ler
  facesPlayer: 0
  document: {fileID: 21300000, guid: 848db6431ee11e9459a4b37107cb6ffa, type: 3}
  purifiedDocument: {fileID: 0}
