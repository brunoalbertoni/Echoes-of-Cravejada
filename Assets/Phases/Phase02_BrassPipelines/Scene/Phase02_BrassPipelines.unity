  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::EchoesOfCravejada.Npc
  displayName: "a picha\xE7\xE3o"
  lines:
  - "L\xE1 no alto, onde s\xF3 chega quem anda pelos canos:"
  - "\"ELES NUNCA DESCERAM AT\xC9 AQUI. NEM PARA VER.\""
  - "E, mais abaixo, outra m\xE3o, de outro dia: \"DAQUI EU VIA AS LUZES DA AVENIDA
    DAS FACETAS PELO RESPIRO DO TETO. APAGARAM-SE UMA A UMA.\""
  purifiedLines:
  - "L\xE1 no alto, onde s\xF3 chega quem anda pelos canos:"
  - "\"ELES NUNCA DESCERAM AT\xC9 AQUI. NEM PARA VER.\""
  - 'Embaixo, em giz novo, numa letra que ainda treme: "Um desceu. Era de sucata."'
  prompt: ler
  facesPlayer: 0
  document: {fileID: 21300000, guid: 00e392fcae9b7214499d95b17c8f9777, type: 3}
