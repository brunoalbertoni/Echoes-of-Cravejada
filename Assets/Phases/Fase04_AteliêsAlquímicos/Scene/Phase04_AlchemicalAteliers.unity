--- !u!114 &399126973
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 399126970}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f7a44ff4d0402c04598a74914119237f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::EchoesOfCravejada.Npc
  nomeExibido: "di\xE1rio de laborat\xF3rio, folha do dia 255"
  linhas2:
  - "\"Dia 255. O Mestre entrou no tanque grande, sozinho. A ideia dele: se o merc\xFArio
    atrasa o \xD3xido, ent\xE3o quem for feito de merc\xFArio n\xE3o apodrece nunca.\""
  - '"Ele saiu. Fala como antes, educado. Mas escorre. E quando ri, o riso continua
    depois que a boca fecha."'
  - "\"Os guardas de prata perfeita passaram a vigiar o laborat\xF3rio. N\xE3o sei
    se t\xE3o protegendo a gente ou ele.\""
  linhasPurificado: []
  indicacao: ler
  jogadorEncara: 0
  documento: {fileID: 21300000, guid: f9b9e6a19dc13c34990de626f0debe53, type: 3}
  documentoPurificado: {fileID: 0}
