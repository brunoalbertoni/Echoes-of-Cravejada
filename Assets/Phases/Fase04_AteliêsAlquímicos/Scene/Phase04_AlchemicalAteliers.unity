  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::EchoesOfCravejada.Npc
  nomeExibido: "ficha de prot\xF3tipo"
  linhas2:
  - "Uma prancheta. Um desenho t\xE9cnico, feito com capricho: cabe\xE7a de quartzo
    bruto, dois olhos, uma mola."
  - "\xC9 voc\xEA. \xC9 o seu corpo, cotado em mil\xEDmetros."
  - "\"PROT\xD3TIPO BRUTO N.\xBA 7. IMUNE AO \xD3XIDO. FUNCIONAL.\""
  - "E, por cima de tudo, carimbado em vermelho: \"REJEITADO \u2014 IMPERFEITO\"."
  - "No campo de destino, impresso: \"PO\xC7O DE SUCATA\"."
  linhasPurificado: []
  indicacao: ler
  jogadorEncara: 0
  documento: {fileID: 21300000, guid: 7d289305b31480c49a8562557a461a9b, type: 3}
  documentoPurificado: {fileID: 0}
