--- !u!114 &2043851949
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2043851946}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f7a44ff4d0402c04598a74914119237f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::EchoesOfCravejada.Npc
  nomeExibido: "di\xE1rio de laborat\xF3rio, folha do dia 12"
  linhas2:
  - "\"Dia 12. Descoberta: o merc\xFArio retarda a corros\xE3o do \xD3xido. Mergulhei
    uma placa de prata no merc\xFArio e deixei do lado de outra, seca, no mesmo vapor
    verde.\""
  - "\"A seca come\xE7ou a manchar no primeiro dia. A mergulhada aguentou tr\xEAs
    dias a mais. \xC9 pouco, mas \xE9 a primeira coisa que funciona.\""
  - "\"Sua Majestade foi informada. H\xE1 esperan\xE7a. Vamos curar a cidade inteira.\""
  - "A letra \xE9 caprichada, de quem t\xE1 feliz."
  linhasPurificado: []
  indicacao: ler
  jogadorEncara: 0
  documento: {fileID: 21300000, guid: 112a46c8d5e3221488e06e25f1265c4a, type: 3}
  documentoPurificado: {fileID: 0}
