  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::EchoesOfCravejada.Npc
  nomeExibido: "di\xE1rio de laborat\xF3rio, folha do dia 90"
  linhas2:
  - "\"Dia 90. Conclus\xE3o ruim: o merc\xFArio s\xF3 atrasa o \xD3xido, n\xE3o cura.
    Em placa, a gente ganha dias. Precisamos saber o que acontece num corpo inteiro.\""
  - "\"Sua Majestade autorizou testes em cobaias de cobre. Disse que tem muitos,
    e que ningu\xE9m vai sentir falta.\""
  linhasPurificado: []
  indicacao: ler
  jogadorEncara: 0
  documento: {fileID: 21300000, guid: e77e8a25c9f315a459376f5a16852883, type: 3}
  documentoPurificado: {fileID: 0}
