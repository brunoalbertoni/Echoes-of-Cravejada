--- !u!114 &1798257422
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1798257419}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f7a44ff4d0402c04598a74914119237f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::EchoesOfCravejada.Npc
  nomeExibido: "di\xE1rio de laborat\xF3rio, folha do dia 300"
  linhas2:
  - "\"Dia 300. Descoberta principal: os prot\xF3tipos brutos s\xE3o imunes. Quartzo
    sem lapidar, bronze sem polimento. O \xD3xido n\xE3o tem onde se agarrar neles.\""
  - "\"Isso \xE9 a cura. Um corpo bruto pra cada um da cidade, e ningu\xE9m mais
    apodrece.\""
  - "\"Levei o n.\xBA 7 at\xE9 o trono, andando. Imune. Sua Majestade recusou: disse
    que a prata n\xE3o vai ser salva por sucata. Ordem de descarte assinada.\""
  linhasPurificado: []
  indicacao: ler
  jogadorEncara: 0
  documento: {fileID: 21300000, guid: 7d573bb4f00db9f47b528c555b499104, type: 3}
  documentoPurificado: {fileID: 0}
