  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f7a44ff4d0402c04598a74914119237f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::EchoesOfCravejada.Npc
  displayName: "di\xE1rio de laborat\xF3rio, folha do dia 150"
  lines:
  - "\"Dia 150. A luz alqu\xEDmica atravessa o \xD3xido e mostra o que j\xE1 apodreceu
    por dentro do metal. Testamos em placas de prata nobre: por dentro, estavam podres.\""
  - "\"Ou seja: a prata tamb\xE9m t\xE1 apodrecendo, a cidade inteira t\xE1. S\xF3
    demora mais pra aparecer. Sua Majestade proibiu que a luz fosse apontada pra
    Corte.\""
  - "\"Aviso pra quem trabalha aqui: as l\xE2mpadas quentes queimam, andem entre
    um clar\xE3o e outro. A fria, a dos espelhos, s\xF3 aponta o caminho.\""
  purifiedLines: []
  prompt: ler
  facesPlayer: 0
  document: {fileID: 21300000, guid: 241bd5e5fa7bd174fa05ee81fa3ce29f, type: 3}
  purifiedDocument: {fileID: 0}
