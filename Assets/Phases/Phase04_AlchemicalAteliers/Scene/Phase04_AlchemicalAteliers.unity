  m_Script: {fileID: 11500000, guid: f7a44ff4d0402c04598a74914119237f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::EchoesOfCravejada.Npc
  displayName: "a ordem no p\xFAlpito"
  lines:
  - "Um papel timbrado com o selo de prata do Rei, preso no p\xFAlpito do palco."
  - "\"O prot\xF3tipo bruto foi apresentado a este Tribunal. \xC9 imune ao \xD3xido.
    Isso n\xE3o muda nada.\""
  - "\"Cravejada est\xE1 apodrecendo, distrito por distrito. Que apodre\xE7a. Prefiro
    uma cidade podre a uma cidade salva por sucata.\""
  - "\"Destino de todo o lote: Po\xE7o de Sucata. Que n\xE3o se fale mais nisso.\""
  - "Assinado, embaixo, numa letra que n\xE3o treme."
  purifiedLines: []
  prompt: ler
  facesPlayer: 0
  document: {fileID: 21300000, guid: b24a7d1ee81b49b41a5535e31fc48368, type: 3}
  purifiedDocument: {fileID: 0}
