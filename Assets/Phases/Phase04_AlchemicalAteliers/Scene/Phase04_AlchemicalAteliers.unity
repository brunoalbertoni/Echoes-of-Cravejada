  m_Script: {fileID: 11500000, guid: f7a44ff4d0402c04598a74914119237f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::EchoesOfCravejada.Npc
  displayName: o quadro das fichas
  lines:
  - "Um quadro de corti\xE7a com seis fichas presas por alfinete, uma pra cada mesa."
  - "N.\xBA 1: \"Ferro fundido. Pesado demais pra andar.\" N.\xBA 2: \"Lat\xE3o.
    O \xD3xido pegou em tr\xEAs dias.\""
  - "N.\xBA 3: \"Cobre. Cobaia for\xE7ada.\""
  - "N.\xBA 4: \"Vidro. Quebrou ao se ver no espelho.\" N.\xBA 5: \"Prata nobre.
    Apodreceu antes de acordar.\""
  - "N.\xBA 6: \"Quartzo lapidado. Perfeito. N\xE3o aguentou o primeiro passo.\""
  - "Tem um s\xE9timo alfinete, sem ficha nenhuma."
  purifiedLines: []
  prompt: ler
  facesPlayer: 0
  document: {fileID: 21300000, guid: b4ee069293fdfbf488b17c0ef5dc780e, type: 3}
  purifiedDocument: {fileID: 0}
