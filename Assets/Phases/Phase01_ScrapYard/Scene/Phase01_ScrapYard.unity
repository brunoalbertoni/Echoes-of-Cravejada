  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::EchoesOfCravejada.InteractCue
  marker: {fileID: 1586084605}
  glow: {fileID: 1312742002}
  bob: 0.12
  period: 1.6
  nearDistance: 2.2
--- !u!114 &1234029219
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1234029217}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f7a44ff4d0402c04598a74914119237f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::EchoesOfCravejada.Npc
  displayName: Pequena
  lines:
  - "Ai! N\xE3o me pega! ...Ah. Voc\xEA n\xE3o \xE9 ele. Ufa."
  - "Eu sou a Pequena. Fui eu que escrevi meu nome no muro, l\xE1 embaixo. Ficou
    meio torto, mas \xE9 meu."
  - "Eu tinha muito, muito medo do Coletor. Ele fazia um barulh\xE3o, CLANC, CLANC,
    e levava todo mundo embora."
  - "A\xED eu me escondi dentro da n\xE9voa. Ela ardia, e minha lata foi ficando
    toda verde... mas l\xE1 dentro ele nunca entrava."
  - Toda vez que eu ouvia ele chegando, tampava os ouvidos e ficava bem quietinha.
    Mesmo doendo.
  - "L\xE1 na obra tem uns ferros pontudos no ch\xE3o, compridos demais pra pular.
    D\xE1 pra passar quicando neles, com o cinzel virado pra baixo."
  - "Depois tem um buraco bem fundo, e l\xE1 no fim um v\xE3o enorme. Eu tentei pular
    um mont\xE3o de vezes. Nunca deu."
  - "Ah! L\xE1 no fundo do buraco tem uma pin\xE7a brilhante. N\xE3o \xE9 minha,
    juro."
  - "Agora que ele n\xE3o vem mais, vou l\xE1 no muro escrever embaixo do meu nome:
    \"ainda aqui\"."
  purifiedLines: []
  prompt: conversar com
  facesPlayer: 1
  document: {fileID: 0}
  purifiedDocument: {fileID: 0}
