  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::EchoesOfCravejada.Npc
  displayName: um decreto dos Nobres
  lines:
  - "Um papel timbrado, com o selo dos 925 em cera prateada. Caiu pela calha junto
    com algu\xE9m."
  - "\"DECRETO DO CONSELHO DOS 925 NOBRES. A corros\xE3o verde n\xE3o atinge a prata
    pura.\""
  - "\"Todo aut\xF4mato de cobre ou de lat\xE3o que apresentar manchas, rangidos
    ou desobedi\xEAncia ser\xE1 recolhido e descartado.\""
  - "\"N\xE3o h\xE1 cura. H\xE1 descarte. Por ordem de Sua Majestade, o Rei de Prata.\""
  purifiedLines: []
  prompt: ler
  facesPlayer: 0
  document: {fileID: 21300000, guid: 4e827f38fafe47e4f94e02761a6ba43b, type: 3}
  purifiedDocument: {fileID: 0}
