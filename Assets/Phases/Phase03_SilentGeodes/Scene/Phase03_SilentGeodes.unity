  m_Script: {fileID: 11500000, guid: f7a44ff4d0402c04598a74914119237f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::EchoesOfCravejada.Npc
  displayName: uma folha de caderno
  lines:
  - "Uma folha arrancada de um caderno de turno, presa na rocha. A letra \xE9 de
    um colega:"
  - '"O capataz foi o primeiro a descer. Ouviu a pedra antes de todo mundo. Dizia
    que ela cantava pra ele."'
  - '"Primeiro ele perdeu os olhos. Depois a voz. Depois parou de caber no capacete."'
  - "\"Desceu sozinho pra toca do fim do corredor e nunca mais subiu. \xC0s vezes
    ainda d\xE1 pra ouvir ele chamando o turno.\""
  purifiedLines: []
  prompt: ler
  facesPlayer: 0
  document: {fileID: 21300000, guid: d640f77d31f360c44b5972d3dbde09cf, type: 3}
  purifiedDocument: {fileID: 0}
