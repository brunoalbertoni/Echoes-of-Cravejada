  m_Script: {fileID: 11500000, guid: 9b28d9f13240c9c4db76eda212b6da8e, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::EchoesOfCravejada.Crisol
  displayName: Crisol
  lines:
  - "Voc\xEA viu a placa. Ent\xE3o agora voc\xEA sabe o que eu sabia."
  - "Eu avisei, e me riscaram. Voc\xEA desceu l\xE1, com esse corpo de sucata, e
    fez a m\xE1quina parar."
  - ...Obrigado, Scrap.
  - "Talvez voc\xEA n\xE3o seja s\xF3 sucata, afinal. N\xE3o me faz repetir."
  - "E agora essa onda \xE9 sua. Usa nos escombros do elevador: eles n\xE3o aguentam.
    L\xE1 em cima fica o Laborat\xF3rio."
  purifiedLines: []
  prompt: conversar com
  facesPlayer: 1
  document: {fileID: 0}
  purifiedDocument: {fileID: 0}
  memoryLines: []
  givesRuby: 0
  repeatLines: []
