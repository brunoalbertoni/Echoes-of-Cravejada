  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::EchoesOfCravejada.Npc
  displayName: "a \xFAltima gravura"
  lines:
  - "Um losango enorme no fundo da terra: o Cora\xE7\xE3o de Quartzo."
  - "H\xE1 uma fenda nele, de cima a baixo. Quem gravou pintou a fenda de verde."
  - "Depois desta, a parede est\xE1 lisa. Ningu\xE9m voltou para gravar o resto."
  purifiedLines: []
  prompt: ler
  facesPlayer: 0
  document: {fileID: 0}
  purifiedDocument: {fileID: 0}
