  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f7a44ff4d0402c04598a74914119237f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::EchoesOfCravejada.Npc
  displayName: uma carta dobrada
  lines:
  - "Uma carta dobrada em quatro, presa atr\xE1s de um cano com um rebite."
  - "\"Pequena, o vapor est\xE1 mais pesado esta semana. N\xE3o venha me visitar
    no turno. Fique no distrito de cobre, perto das janelas.\""
  - "\"Se mandarem todo mundo descer pela calha, n\xE3o tenha medo. Eu des\xE7o os
    canos atr\xE1s de voc\xEA. Prometo.\""
  - A carta nunca foi enviada.
  purifiedLines: []
  prompt: ler
  facesPlayer: 0
