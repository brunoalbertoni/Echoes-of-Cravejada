  m_EditorClassIdentifier: Assembly-CSharp::EchoesOfCravejada.Npc
  displayName: o desenho
  lines:
  - "Um desenho tosco, feito a giz, ao lado do cabide: uma m\xE1scara de soldador."
  - "Embaixo, outra m\xE3o escreveu: \"Quem tem m\xE1scara tem cara.\""
  - "E, mais embaixo, uma terceira: \"E quem n\xE3o tem?\""
  purifiedLines: []
  prompt: ler
  facesPlayer: 0
  document: {fileID: 21300000, guid: 7b90fffd36db0f34bb9d9bdf7a934b5a, type: 3}
  purifiedDocument: {fileID: 0}
