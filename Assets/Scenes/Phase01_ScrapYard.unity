MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 896086217}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f7a44ff4d0402c04598a74914119237f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::EchoesOfCravejada.Npc
  displayName: o muro dos nomes
  lines:
  - "A rocha est\xE1 coberta de riscos, uns por cima dos outros: n\xFAmeros de s\xE9rie,
    apelidos, pequenas engrenagens desenhadas."
  - "\"LAMPI\xC3O-12. AINDA ACENDO.\" \"BIGORNA. TRABALHEI QUARENTA ANOS.\" \"PEQUENA.
    NUNCA TIVE N\xDAMERO.\""
  - "Embaixo de todos, em letra grande: \"QUEM LER ISTO, LEMBRE-SE DE N\xD3S.\""
  - "No fim da parede ainda h\xE1 espa\xE7o. Algu\xE9m deixou um prego pendurado
    ali, \xE0 espera do pr\xF3ximo nome."
  purifiedLines:
  - "A rocha est\xE1 coberta de riscos, uns por cima dos outros: n\xFAmeros de s\xE9rie,
    apelidos, pequenas engrenagens desenhadas."
  - "Embaixo de \"PEQUENA. NUNCA TIVE N\xDAMERO.\", algu\xE9m acrescentou, em letra
    fresca: \"AINDA AQUI.\""
  - "O prego que estava pendurado no fim da parede foi usado. No espa\xE7o vazio,
    rec\xE9m-riscado: \"COLETOR N.\xBA 1. TAMB\xC9M ERA UM DE N\xD3S.\""
  - "Embaixo de todos, em letra grande: \"QUEM LER ISTO, LEMBRE-SE DE N\xD3S.\""
  prompt: ler
  facesPlayer: 0
