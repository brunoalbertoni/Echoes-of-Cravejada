  m_Script: {fileID: 11500000, guid: f7a44ff4d0402c04598a74914119237f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::EchoesOfCravejada.Npc
  displayName: a placa do Coletor
  lines:
  - "Onde o Coletor caiu, sobrou um peda\xE7o de chassi com uma placa de lat\xE3o
    rebitada. A ferrugem se soltou com a queda."
  - "\"COLETOR DE REFUGO N.\xBA 1 \u2014 SERVI\xC7O DE LIMPEZA DA COROA. MANTER O
    PO\xC7O LIMPO. N\xC3O PARAR.\""
  - "Ningu\xE9m jamais desceu para mand\xE1-lo parar."
  - "Preso entre as chapas h\xE1 algo que n\xE3o \xE9 dele: um aro de prata pequeno,
    bem polido. Voc\xEA o guarda."
  purifiedLines: []
  prompt: ler
  facesPlayer: 0
