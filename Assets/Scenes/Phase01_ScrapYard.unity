  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f7a44ff4d0402c04598a74914119237f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::EchoesOfCravejada.Npc
  displayName: um decreto dos Nobres
  lines:
  - "Um papel timbrado, com o selo dos 925 em cera prateada. Desceu pela calha junto
    com algu\xE9m."
  - "\"DECRETO DO CONSELHO DOS 925 NOBLES. A corros\xE3o verde n\xE3o atinge a prata
    pura.\""
  - "\"Todo aut\xF4mato de cobre ou de lat\xE3o que apresentar manchas, rangidos
    ou desobedi\xEAncia ser\xE1 recolhido e descartado.\""
  - "\"N\xE3o h\xE1 cura. H\xE1 descarte. Por ordem de Sua Majestade, o Rei de Prata.\""
  - "Na margem, algu\xE9m anotou a carv\xE3o: \"a prata tamb\xE9m mancha. Eu vi.\""
  purifiedLines: []
  prompt: ler
  facesPlayer: 0
