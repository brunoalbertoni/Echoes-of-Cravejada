  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f7a44ff4d0402c04598a74914119237f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::EchoesOfCravejada.Npc
  displayName: diario de laboratorio, ultima folha
  lines:
  - '"Dia 300. Os prototipos brutos sao imunes. Quartzo nao lapidado, bronze sem
    polir: o Oxide nao pega neles."'
  - '"Levei um ate o trono. Andando. Imune. A cura da cidade inteira, de pe na frente
    dele."'
  - '"Sua Majestade recusou. Disse que a prata nao sera salva por sucata. Ordem de
    descarte assinada."'
  prompt: ler
  facesPlayer: 0
